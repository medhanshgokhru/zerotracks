# Optional live mode. Leave unset for the strict local-only privacy mode.
# If set, the gateway and upstream provider receive submitted queries.
# Never put provider keys in VITE_*.
# VITE_SEARCH_API_URL=https://search.example.org/api

# Search service settings. Local development defaults are ready to use.
# SEARCH_HOST=127.0.0.1
# SEARCH_PORT=8788
# ALLOWED_ORIGINS=https://your-account.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173